# CommerceGov Contacts — local environment (placeholder values only)
APP_HOST=127.0.0.1
PORT=8025
DATABASE_PATH=./leads.db
MAX_PASTE_CHARS=200000
LOG_LEVEL=INFO

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_TIMEOUT=60

# Optional PostgreSQL (Phase 1+). When set, the web app uses PostgreSQL instead of SQLite.
DATABASE_URL=postgresql://user:password@localhost:5432/contacts

# Isolated database for PostgreSQL integration tests (must be disposable).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/contacts_test

# Gmail G0 (read-only; disabled by default)
GMAIL_ENABLED=false
GMAIL_CLIENT_SECRET_PATH=
GMAIL_TOKEN_PATH=
GMAIL_SYNC_LABEL=LMStudio
GMAIL_SYNC_LIMIT=100
APP_TIMEZONE=Asia/Jerusalem

# Knowledge ingestion (SQLite runtime only)
KNOWLEDGE_STORAGE_DIR=./knowledge_store
KNOWLEDGE_MAX_UPLOAD_MB=25
# Set only to a model loaded in LM Studio that accepts image input; empty disables vision.
KNOWLEDGE_VISION_MODEL=
KNOWLEDGE_CLASSIFY=true

# Knowledge embeddings (Phase K1; disabled by default, local endpoint only)
KNOWLEDGE_EMBEDDINGS_ENABLED=false
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_TIMEOUT=30
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_EMBEDDING_ALLOW_REMOTE=false
KNOWLEDGE_EMBED_ON_INGEST=true
KNOWLEDGE_SEMANTIC_MIN_SCORE=0.25
KNOWLEDGE_SEMANTIC_MAX_CANDIDATES=5000
