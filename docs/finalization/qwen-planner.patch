+class _FakeResponse:
+    def __init__(self, payload):
+        self._payload = payload
+        self.is_success = True
+
+    def json(self):
+        return self._payload
+
+
+class _FakeClient:
+    captured = []
+
+    def __init__(self, timeout):
+        self.timeout = timeout
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    def post(self, url, json):
+        self.captured.append(json)
+        return _FakeResponse(
+            {
+                "choices": [
+                    {
+                        "message": {
+                            "content": "thinking out loud",
+                            "reasoning_content": (
+                                '{"action":"tool","tool_name":"search_contacts","arguments":{}}'
+                            ),
+                        }
+                    }
+                ]
+            }
+        )
+
+
+def test_planner_requests_reasoning_off_and_ignores_reasoning_channel():
+    with patch("services.llm_planner.call_lmstudio_for_text", return_value=None) as caller:
+        assert plan_question_with_local_llm("Which partner agencies operate in Berlin?") is None
+
+    assert caller.call_args.kwargs["reasoning_effort"] == "none"
+    assert caller.call_args.kwargs["timeout_s"] == 180.0
+
+
+def test_text_call_omits_reasoning_effort_unless_requested():
+    _FakeClient.captured = []
+    with patch("llm.httpx.Client", _FakeClient):
+        assert llm.call_lmstudio_for_text("classify this") is None
+        assert llm.call_lmstudio_for_text("plan this", reasoning_effort="none") is None
+
+    assert "reasoning_effort" not in _FakeClient.captured[0]
+    assert _FakeClient.captured[1]["reasoning_effort"] == "none"
+
